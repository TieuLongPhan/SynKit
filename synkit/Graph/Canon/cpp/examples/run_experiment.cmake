# Execute one native study and keep its scientific result JSON only.
cmake_minimum_required(VERSION 3.19)
foreach(required RUNNER INPUT OUTPUT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Pass -DRUNNER=... -DINPUT=... -DOUTPUT=... before -P")
  endif()
  get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
if(EXISTS "${OUTPUT}")
  message(FATAL_ERROR "Select a new result output path")
endif()
if(NOT DEFINED MODE)
  set(MODE analyze)
endif()
if(NOT DEFINED REPETITIONS)
  set(REPETITIONS 3)
endif()
if(NOT DEFINED SECONDS)
  set(SECONDS 5)
endif()
if(NOT DEFINED TIMEOUT)
  set(TIMEOUT 1800)
endif()
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
get_filename_component(runner_name "${RUNNER}" NAME)
file(MAKE_DIRECTORY "${output_dir}")
set(extra_args)
if(runner_name MATCHES "^(science_experiments|stereo_conformance)")
  foreach(optional SDF REFERENCE ROOT)
    if(DEFINED ${optional})
      string(TOLOWER "${optional}" flag)
      list(APPEND extra_args "--${flag}" "${${optional}}")
    endif()
  endforeach()
else()
  list(APPEND extra_args --repetitions "${REPETITIONS}")
endif()
if(CODES)
  list(APPEND extra_args --codes)
endif()
execute_process(COMMAND "${RUNNER}" --input "${INPUT}" --output "${OUTPUT}"
  --mode "${MODE}" --seconds "${SECONDS}" ${extra_args}
  RESULT_VARIABLE status TIMEOUT "${TIMEOUT}"
  OUTPUT_VARIABLE experiment_stdout ERROR_VARIABLE experiment_stderr)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Native study failed (${status}): ${experiment_stderr}\n${experiment_stdout}")
endif()
message(STATUS "Completed native study: ${OUTPUT}")
