# Execute the frozen native scientific suite without Python.
cmake_minimum_required(VERSION 3.19)
foreach(required RUNNER_DIR DATA_DIR OUTPUT_DIR)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Pass -DRUNNER_DIR=... -DDATA_DIR=... -DOUTPUT_DIR=... before -P")
  endif()
  get_filename_component(${required} "${${required}}" ABSOLUTE)
endforeach()
if(EXISTS "${OUTPUT_DIR}")
  message(FATAL_ERROR "Select a new output directory")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(native_suffix "")
if(WIN32)
  set(native_suffix ".exe")
endif()
set(ENV{OMP_NUM_THREADS} 1)
set(ENV{OPENBLAS_NUM_THREADS} 1)
set(ENV{MKL_NUM_THREADS} 1)
set(native_index 0)
function(native_stage name executable mode input)
  cmake_parse_arguments(STAGE "CODES" "SECONDS;REFERENCE;SDF;ROOT" "" ${ARGN})
  if(NOT DEFINED STAGE_SECONDS)
    set(STAGE_SECONDS 5)
  endif()
  set(args "-DRUNNER=${RUNNER_DIR}/${executable}${native_suffix}"
    "-DINPUT=${DATA_DIR}/${input}" "-DOUTPUT=${OUTPUT_DIR}/${name}.json"
    "-DMODE=${mode}" "-DSECONDS=${STAGE_SECONDS}" "-DREPETITIONS=3")
  foreach(optional REFERENCE SDF ROOT)
    if(DEFINED STAGE_${optional})
      list(APPEND args "-D${optional}=${DATA_DIR}/${STAGE_${optional}}")
    endif()
  endforeach()
  if(STAGE_CODES)
    list(APPEND args "-DCODES=ON")
  endif()
  message(STATUS "Running native stage: ${name}")
  execute_process(COMMAND "${CMAKE_COMMAND}" ${args} -P "${CMAKE_CURRENT_LIST_DIR}/run_experiment.cmake"
    RESULT_VARIABLE status)
  math(EXPR native_index "${native_index}+1")
  set(native_index "${native_index}" PARENT_SCOPE)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native stage failed: ${name}; partial result reports are retained")
  endif()
endfunction()
native_stage(independent stereo_experiments analyze independent_inputs.json CODES)
native_stage(local_internal stereo_experiments analyze local_internal_inputs.json)
native_stage(rota_configured stereo_experiments analyze rota_configured_inputs.json)
native_stage(cip_smiles science_experiments cip compounds.smi REFERENCE cip_smiles_reference.json)
native_stage(cip_coordinates science_experiments cip compounds.smi SDF compounds_3d.sdf REFERENCE cip_coordinates_reference.json)
native_stage(perception science_experiments perception perception_inputs.json REFERENCE perception_reference.json SECONDS 10)
native_stage(local_orders science_experiments local perception_inputs.json REFERENCE local_count_reference.json SECONDS 10)
native_stage(source_and_global science_experiments identity acs_inputs.json REFERENCE exact_plus_global_reference.json)
native_stage(coordination science_experiments coordination coordination_inputs.json REFERENCE coordination_reference.json ROOT coordination_root)
native_stage(chemical_negatives science_experiments perception negative_inputs.json)
native_stage(conformance stereo_conformance conformance conformance_inputs.json)
native_stage(overlap science_experiments overlap perception_inputs.json)
native_stage(representation science_experiments representation representation_inputs.json)
native_stage(registration stereo_experiments registration registration_inputs.json)
native_stage(atom_group_costs stereo_experiments costs controlled_costs_inputs.json SECONDS 1)
message(STATUS "Completed ${native_index} native scientific stages: ${OUTPUT_DIR}")
